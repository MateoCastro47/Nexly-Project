# ─────────────────────────────────────────────────────────────
# Nexly — variables de entorno del backend
# Copia este archivo a .env y rellena los valores. NUNCA subas el .env real.
# ─────────────────────────────────────────────────────────────

# ── Base de datos MySQL ──
DB_URL=jdbc:mysql://localhost:3306/nexly?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=tu_password

# ── OAuth2 Google (Google Cloud Console > Credenciales) ──
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# ── JWT ──
# Secreto Base64 de al menos 32 bytes. Genera uno con: openssl rand -base64 32
JWT_SECRET=cambia_esto_por_un_secreto_base64_de_32_bytes
# Opcional (por defecto 86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# ── Cloudinary (subida de imágenes/vídeo) ──
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Front / CORS / cookie (todas opcionales, tienen valor por defecto) ──
FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_NAME=nexly_token
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.*.*:5173

# ── Web Push (VAPID) ──
# Genera el par con:  npx web-push generate-vapid-keys --json
# Si las dejas vacías, la app arranca igual pero el push queda deshabilitado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@dominio.com
